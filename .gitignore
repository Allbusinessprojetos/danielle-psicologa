# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Material de referência do cliente (pesado, não versionar)
referencia lp/

# Claude Code session files (machine/session-specific, not part of the project)
.claude/

# Ad-hoc verification screenshots left at root by implementer subagents
/*.png
.playwright-mcp/
